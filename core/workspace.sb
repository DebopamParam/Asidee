(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "WS")))
(allow file-write*
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/dtracehelper")
  (literal "/dev/tty") (regex #"^/dev/ttys[0-9]+$") (literal "/dev/ptmx") (regex #"^/dev/fd/[0-9]+$"))
(deny file-read* (subpath (param "HOME_REAL")))
(deny file-read* (subpath "/private/tmp") (subpath "/private/var/tmp") (subpath (param "USER_VAR")))
(allow file-read* (subpath (param "WS")))
(deny network-outbound (remote unix-socket))
(allow network-outbound (remote unix-socket (subpath (param "WS"))))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
(deny lsopen)
(deny mach-lookup (global-name "com.apple.lsd.modifydb"))
(deny appleevent-send)
(deny job-creation)
(deny user-preference-read)
(deny user-preference-write)
(deny mach-lookup (global-name "com.apple.pasteboard.1"))
(deny signal)
(allow signal (target same-sandbox))
(deny process-info*)
(allow process-info* (target same-sandbox))
(allow process-info-listpids)
(deny device-camera)
(deny device-microphone)
